name "power_sense_module"

import_types_from "power_sense_moduleTypes.hpp"
import_types_from "std"
import_types_from "raw_io"


# Outputs the current and the voltage readings of the bluerobotics Power Sense Module
# connected to an ADS1115
task_context "Task" do
    needs_configuration

    property "current_reading", "uint8_t", 3
    property "voltage_reading", "uint8_t", 4
    property "voltage_scale", "double", 11.0
    property "current_scale", "double", 37.8788

    input_port "analog_samples", "/std/vector<raw_io/Analog>"

    output_port "voltage", "/power_sense_module/Voltage"
    output_port "current", "/power_sense_module/Current"

    periodic 0.1
end
